# Telegram Bot Configuration

# Get your token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ADMIN_IDS=123456789


# MongoDB Configuration

MONGO_URI=YOUR_MONGODB_CONNECTION_URI

# SSH Configuration

# SSH connection timeout (seconds)
SSH_TIMEOUT=15
SSH_KNOWN_HOSTS=/root/.ssh/known_hosts

# Maximum simultaneous SSH connections
MAX_CONNECTIONS=10


# File Manager Configuration


# Maximum file download size via Telegram (MB)
MAX_FILE_SIZE_MB=50

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.txt,.py,.js,.json,.yml,.yaml,.conf,.jpg

# Logging Configuration

# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Web Dashboard Login (Optional)
WEB_PORT=3000
WEB_USERNAME=change_me
WEB_PASSWORD=use_a_long_random_password
WEB_COOKIE_SECURE=1
